[Unit]
Description=Preserve Casper Loto API and bot diagnostic logs
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/k-loto
ExecStart=/usr/bin/python3 /opt/k-loto/scripts/server_maintenance.py --archive-logs
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
