import /etc/caddy/extensions/*.caddy

{$WEB_HOST} {
    encode zstd gzip
    handle /health {
        reverse_proxy api:8000
    }
    @retired_web_api path /api/v1/web /api/v1/web/*
    handle @retired_web_api {
        respond 404
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /assets/* {
        root * /srv/miniapp
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle /brand/* {
        root * /srv/miniapp
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @retired_web path /web /web/*
    handle @retired_web {
        respond "Web version is no longer available. Open the Telegram Mini App." 410
    }
    handle {
        root * /srv/miniapp
        try_files {path} /index.html
        header Cache-Control "no-cache, must-revalidate"
        file_server
    }
}

{$ADMIN_HOST} {
    encode zstd gzip
    handle /health {
        reverse_proxy api:8000
    }
    @retired_web_api path /api/v1/web /api/v1/web/*
    handle @retired_web_api {
        respond 404
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv/admin
        try_files {path} /index.html
        header Cache-Control "no-cache, must-revalidate"
        file_server
    }
}
