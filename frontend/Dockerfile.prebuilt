FROM caddy:2.10-alpine

LABEL com.docker.compose.project="k-loto"
LABEL com.docker.compose.service="gateway"

COPY infrastructure/Caddyfile /etc/caddy/Caddyfile
COPY infrastructure/legal-miniapp.caddy /etc/caddy/extensions/legal-miniapp.caddy
COPY frontend/admin/dist /srv/admin
COPY frontend/miniapp/dist /srv/miniapp
COPY frontend/web/dist /srv/web
